#!/bin/zsh
set -e

source ~/.zsh_secrets 2>/dev/null || true
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh
[[ -d /opt/homebrew/bin ]] && export PATH="/opt/homebrew/bin:$PATH"
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

selected=$(
    { for dir in "$HOME/Projects" \
                 "$HOME/Projects/cpi/ideas" \
                 "$HOME/Projects/cpi/presentations" \
                 "$HOME/Projects/cpi"; do
        if [[ -d "$dir" ]]; then
          find "$dir" -mindepth 1 -maxdepth 1 -type d
        fi
      done
      echo "$HOME/dotfiles"
      if [[ -n "$vault" ]]; then
        echo "$vault"
      fi
    } | fzf --prompt="  "
)
[[ -z "$selected" ]] && exit 0

name=$(basename "$selected" | tr '. ' '__')

workspace_id=$(
    herdr workspace list 2>/dev/null |
        jq -r --arg selected "$selected" --arg name "$name" '
            (.result.workspaces // .workspaces // [])[]? |
            select((.cwd // .root_cwd // "") == $selected or (.label // "") == $name) |
            .workspace_id // .id
        ' |
        head -n 1
)

if [[ -n "$workspace_id" ]]; then
    herdr workspace focus "$workspace_id" >/dev/null
    exit 0
fi

created=$(
    herdr workspace create --cwd "$selected" --label "$name" --focus 2>/dev/null || true
)

workspace_id=$(
    printf '%s\n' "$created" |
        jq -r '.result.workspace.workspace_id // .workspace.workspace_id // .workspace.id // .id // empty' 2>/dev/null |
        head -n 1
)

if [[ -z "$workspace_id" ]]; then
    workspace_id=$(
        herdr workspace list 2>/dev/null |
            jq -r --arg selected "$selected" --arg name "$name" '
                (.result.workspaces // .workspaces // [])[]? |
                select((.cwd // .root_cwd // "") == $selected or (.label // "") == $name) |
                .workspace_id // .id
            ' |
            head -n 1
    )
fi

if [[ -n "$workspace_id" ]]; then
    # Tabs stay unlabeled; the herdr-automatic-rename plugin names them by foreground process.
    for _ in 1 2 3; do
        herdr tab create --workspace "$workspace_id" --cwd "$selected" --no-focus >/dev/null 2>&1 || true
    done
    herdr workspace focus "$workspace_id" >/dev/null 2>&1 || true
fi
