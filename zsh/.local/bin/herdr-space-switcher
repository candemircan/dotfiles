#!/bin/zsh
set -e

[[ -d /opt/homebrew/bin ]] && export PATH="/opt/homebrew/bin:$PATH"

selected=$(
    herdr workspace list 2>/dev/null |
        jq -r '
            .result.workspaces[]? |
            [
                .workspace_id,
                (if .focused then "*" else " " end),
                .label,
                (.agent_status // "unknown")
            ] |
            @tsv
        ' |
        fzf --prompt="space: " --with-nth=2,3,4 --delimiter=$'\t'
)

[[ -z "$selected" ]] && exit 0

workspace_id=$(printf '%s\n' "$selected" | cut -f1)
[[ -n "$workspace_id" ]] && herdr workspace focus "$workspace_id" >/dev/null
